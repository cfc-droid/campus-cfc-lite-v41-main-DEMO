# =========================================================
# 🔐 CFC-ROOT-GUARD V45 — FIX loops Cloudflare Pages + frontend/
# =========================================================

# 0) Permitir acceso a login y a cualquier archivo dentro de /html/
#    (Cloudflare necesita esto para NO capturar login.html con el catch-all)
# ---------------------------------------------------------
/html/*                     /html/:splat            200

# 1) Permitir login explícito
# ---------------------------------------------------------
/html/login.html            /html/login.html        200
/html/login                 /html/login.html        200

# 2) Permitir recursos estáticos
# ---------------------------------------------------------
/js/*                       /js/:splat              200
/css/*                      /css/:splat             200
/img/*                      /img/:splat             200
/assets/*                   /assets/:splat          200
/sounds/*                   /sounds/:splat          200
/media/*                    /media/:splat           200

# 3) Permitir archivos raíz
# ---------------------------------------------------------
/sw.js                      /sw.js                 200
/manifest.json              /manifest.json         200

# 4) Bloquear TODAS las páginas internas (redirigir a login)
# ---------------------------------------------------------
/index.html                 /html/login.html        302
/modules/*                  /html/login.html        302
/backend/*                  /html/login.html        302
/pages/*                    /html/login.html        302
/out/*                      /html/login.html        302

# 5) Catch-all FINAL (solo rutas no coincidentes)
# ---------------------------------------------------------
/*                          /html/login.html        302
