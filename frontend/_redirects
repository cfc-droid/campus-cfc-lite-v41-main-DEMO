# =========================================================
# CFC-ROOT-GUARD V47 — Cloudflare Pages (root=frontend)
# Modo 100% PRIVADO — solo login permitido
# =========================================================

# 1) ÚNICA página pública permitida
/html/login.html     /html/login.html    200
/html/login          /html/login.html    200

# 2) Permitir recursos estáticos necesarios
/js/*                /js/:splat          200
/css/*               /css/:splat         200
/img/*               /img/:splat         200
/sounds/*            /sounds/:splat      200
/media/*             /media/:splat       200
/assets/*            /assets/:splat      200

# 3) Archivos raíz necesarios
/sw.js               /sw.js              200
/manifest.json       /manifest.json      200

# 4) BLOQUEAR TODAS LAS RUTAS INTERNAS (redirigir SIEMPRE al login)
#    Nadie puede entrar sin usuario y contraseña

/                     /html/login.html   302
/index.html           /html/login.html   302
/main.html            /html/login.html   302
/intro.html           /html/login.html   302
/results.html         /html/login.html   302
/bitacora.html        /html/login.html   302
/admin.html           /html/login.html   302

/pages/*              /html/login.html   302
